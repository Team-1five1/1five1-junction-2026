{
  "name": "verius",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun run scripts/migrate.ts",
    "tenant:provision": "bun run scripts/provision-tenant.ts",
    "wordpress:connect": "bun run scripts/connect-wordpress.ts",
    "verify:e2e": "bun run scripts/verify-e2e.ts",
    "verify:wordpress": "docker compose exec -T wordpress php < scripts/verify-wordpress.php",
    "verify:browser": "node scripts/verify-collector-browser.mjs",
    "seed": "bun run scripts/manage-test-data.ts seed",
    "seed:clear": "bun run scripts/manage-test-data.ts clear",
    "clear": "bun run scripts/manage-test-data.ts clear --all",
    "clear:all": "bun run scripts/manage-test-data.ts clear --all",
    "clear:seed": "bun run scripts/manage-test-data.ts clear",
    "clear:non-seed": "bun run scripts/manage-test-data.ts clear --non-seed",
    "db:clear": "bun run scripts/manage-test-data.ts clear --all",
    "test:swarm": "bun ./scripts/test-bot-swarm.ts",
    "demo:honeypot": "bun ./scripts/demo-puppeteer-honeypot.ts",
    "test:honeypot-browser": "bun ./scripts/demo-puppeteer-honeypot.ts --headless"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.65.1",
    "puppeteer-core": "^25.17.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@fingerprintjs/botd": "^2.0.0",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "ioredis": "^6.0.0",
    "postgres": "^4.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  }
}
